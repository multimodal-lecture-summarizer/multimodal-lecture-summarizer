# Copy to .env and fill in values. Never commit .env

# ─── Database ───
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/video_summarizer

# ─── Redis / Celery ───
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── JWT Security ───
SECRET_KEY=change-me-in-production

# ─── GPU ───
CUDA_VISIBLE_DEVICES=0
# Keep Florence on CPU/FP32 for identical behavior on CPU-only and GPU hosts.
# Set to cuda only when speed is preferred over cross-device token identity.
FLORENCE_DEVICE=cpu

# ─── Quality post-process (after summarizer) ───
# recommended = S1 chapter smooth + S3 OCR enrich + S4v2 prune + S7 transcript fallback
# sprint10 / full = recommended + S5 coverage + S8 soft caption + S9 hints + S10 score
ENABLE_SPRINT_STACK=1
SPRINT_STACK=recommended
MIN_CHAPTER_SEC=45

# ─── HuggingFace (required for pyannote models) ───
HF_TOKEN=

# ─── API providers (stack_api / stack_hybrid) ───
OPENAI_API_KEY=
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# ─── Optional OCR API ───
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Ollama (stack_local_gpu text) ───
OLLAMA_BASE_URL=http://localhost:11434

# ─── Frontend ───
VITE_API_BASE_URL=http://localhost:8000/api
