# App configuration
APP_NAME="AI Video Summarizer Backend"
APP_ENV="development" # development, production
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="YOUR_SUPER_SECRET_KEY_MIN_32_CHARS_GOES_HERE"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days

# PostgreSQL
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="lecture_summarizer"

# Cloudflare R2 / S3 Compatible Storage
CF_R2_ACCOUNT_ID="your_account_id"
CF_R2_ACCESS_KEY_ID="your_access_key_id"
CF_R2_SECRET_ACCESS_KEY="your_secret_access_key"
CF_R2_BUCKET_NAME="lecture-summarizer-assets"
CF_R2_PUBLIC_URL="https://pub-your-bucket-id.r2.dev"

# Groq API
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama3-8b-8192"

# ChromaDB
CHROMADB_HOST="localhost"
CHROMADB_PORT=8000
CHROMADB_SSL=False
CHROMADB_API_KEY=""
CHROMADB_TENANT="default_tenant"
CHROMADB_DATABASE="default_database"
CHROMADB_COLLECTION_NAME="lecture_transcript_embeddings"

# Standard limits (as backup defaults, actual standards are stored in database)
DEFAULT_MAX_DURATION_SECONDS=3600
DEFAULT_ALLOWED_FORMATS="mp4,avi,mkv"
DEFAULT_MAX_FILE_SIZE_MB=500

# Celery & Redis
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"
